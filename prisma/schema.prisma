// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id    String  @id @default(auto()) @map("_id") @db.ObjectId
  email   String   @unique
  name    String  
  age     String
}

model Rejeito {
  id    String  @id @default(auto()) @map("_id") @db.ObjectId
  codigo_interno   String   @unique
  descricao   String
  categoria_id   String
  blindagem_id   String
  peso_bruto_kg   Float
  peso_blindagem_kg   Float
  peso_liquido_kg   Float
  dimensoes_externas_cm   String
  dimensoes_internas_cm   String
  atividade_total_bq   Float
  data_medicao_total   DateTime
  data_recebimento   DateTime
  data_liberacao   DateTime
  status_id   String
  local_armazenamento_id   String
}

model Material {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  nome      String @unique
  descricao String
}

model Categoria {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  nome      String @unique
  descricao String
}

model Status {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  nome      String @unique
  descricao String
}

model LocalArmazenamento {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  nome      String @unique
  descricao String
}

model Blindagem {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  nome      String @unique
  descricao   String
}

model Radionclideos {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  simbolo      String @unique
  nome_comum String
  meia_vida_dias   Float
  descricao   String
}

model RejeitoRadionuclideo {
  rejeito_id        String @id @default(auto()) @map("_id") @db.ObjectId
  radionuclideo_id      String @unique
  atividade_especifica_bq Float
  data_medicao   DateTime
}

model RejeitoMaterial {
  rejeito_id        String @id @default(auto()) @map("_id") @db.ObjectId
  radionuclideo_id      String @unique
  percentual   Float
}

model HistoricoRejeito {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  rejeito_id      String @unique
  data_modificacao   DateTime
  tipo_modificacao   String
  descricao   String
  usuario_responsavel   String
}


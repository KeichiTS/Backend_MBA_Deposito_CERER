// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id    String  @id @default(auto()) @map("_id") @db.ObjectId
  email   String   @unique
  name    String  
  age     String
}

model Rejeito {
  id    String  @id @default(auto()) @map("_id") @db.ObjectId
  codigo_interno   String   @unique
  categoria_id   Int
  material_id   Int
  descricao   String
  peso_kg   Float
  dimensoes_cm   String
  atividade_bq   Float
  data_medicao_atividade   DateTime
  tempo_decaimento_dias   Float
  nivel_referencia_bq   Float
  data_recebimento   DateTime
  data_liberacao   DateTime
  status_id   Int
  local_armazenamento_id   Int
}

